<Application x:Class="VisumCRM.Client.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisumCRM.Client.Wpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles_Normal.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/Resources/Languages_ENUS.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/Resources/Colors_Normal.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
