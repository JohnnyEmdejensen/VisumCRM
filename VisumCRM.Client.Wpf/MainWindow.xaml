<Window x:Class="VisumCRM.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisumCRM.Client.Wpf"
        mc:Ignorable="d"
        Tag="Desktop" ResizeMode="CanResizeWithGrip" MinHeight="1000" Height="1000" MinWidth="1600" Width="1600" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Icon="/Images/pilot1_48.png">
    <Border BorderThickness="3" CornerRadius="16" BorderBrush="{DynamicResource desktop.bordercolor}" Background="{DynamicResource desktop.background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="3"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="3"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtTitle" MouseLeftButtonDown="txtTitle_MouseLeftButtonDown" Grid.Column="0" Style="{DynamicResource dialog.titlebar.text}" Text="{DynamicResource desktop.header.title}" VerticalAlignment="Center"></TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Image x:Name="imgMin" MouseLeftButtonDown="imgMin_MouseLeftButtonDown" Source="/Images/minimize.png" Cursor="Hand"></Image>
                    <Label Width="8"></Label>
                    <Image x:Name="imgMax" MouseLeftButtonDown="imgMax_MouseLeftButtonDown" Source="/Images/maximize.png" Cursor="Hand"></Image>
                    <Image x:Name="imgRes" MouseLeftButtonDown="imgRes_MouseLeftButtonDown" Source="/Images/restore.png" Cursor="Hand" Visibility="Collapsed"></Image>
                    <Label Width="8"></Label>
                    <Image x:Name="imgCls" MouseLeftButtonDown="imgCls_MouseLeftButtonDown" Source="/Images/close.png" Cursor="Hand"></Image>
                    <Label Width="8"></Label>
                </StackPanel>

            </Grid>
            <Label Grid.Row="1" Style="{DynamicResource desktop.border}"></Label>
            <Ribbon Grid.Row="2">
                <RibbonTab Header="{DynamicResource desktop.ribbon.tab.header.home}" IsSelected="True">
                    <RibbonGroup Header="{DynamicResource desktop.ribbon.group.header.creations}">
                        <RibbonSplitButton Label="{DynamicResource desktop.ribbon.button.header.create}" SmallImageSource="/Images/document_new_16.png" LargeImageSource="/Images/document_new_32.png">
                            <RibbonMenuItem x:Name="mnuCreateCompany" Header="{DynamicResource desktop.ribbon.menuitem.header.create.company}"></RibbonMenuItem>
                        </RibbonSplitButton>
                    </RibbonGroup>
                </RibbonTab>
                <RibbonTab Header="{DynamicResource desktop.ribbon.tab.header.settings}">
                    <RibbonGroup Header="{DynamicResource desktop.ribbon.group.header.systemdata}">

                    </RibbonGroup>
                </RibbonTab>
            </Ribbon>
        </Grid>
    </Border>
</Window>
