<Window x:Class="VisumCRM.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisumCRM.Client.Wpf"
        mc:Ignorable="d"
        Tag="Desktop" ResizeMode="CanResizeWithGrip" MinHeight="1000" Height="1000" MinWidth="1600" Width="1600" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Icon="/Images/magician_48.png">
    <Border BorderThickness="3" BorderBrush="{DynamicResource desktop.bordercolor}" Background="{DynamicResource desktop.background}" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="3"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="3"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtTitle" MouseLeftButtonDown="txtTitle_MouseLeftButtonDown" Grid.Column="0" Style="{DynamicResource dialog.titlebar.text}" Text="{DynamicResource desktop.header.title}" VerticalAlignment="Center"></TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Image x:Name="imgMin" MouseLeftButtonDown="imgMin_MouseLeftButtonDown" Source="/Images/minimize.png" Cursor="Hand"></Image>
                    <Label Width="8"></Label>
                    <Image x:Name="imgMax" MouseLeftButtonDown="imgMax_MouseLeftButtonDown" Source="/Images/maximize.png" Cursor="Hand"></Image>
                    <Image x:Name="imgRes" MouseLeftButtonDown="imgRes_MouseLeftButtonDown" Source="/Images/restore.png" Cursor="Hand" Visibility="Collapsed"></Image>
                    <Label Width="8"></Label>
                    <Image x:Name="imgCls" MouseLeftButtonDown="imgCls_MouseLeftButtonDown" Source="/Images/close.png" Cursor="Hand"></Image>
                    <Label Width="8"></Label>
                </StackPanel>
            </Grid>
            <Label Grid.Row="1" Background="{DynamicResource desktop.bordercolor}"></Label>
            <Ribbon Grid.Row="2">
                <RibbonTab Header="HOME" IsSelected="True">
                    <RibbonGroup Header="Creations">
                        <RibbonMenuButton Label="Create New..." LargeImageSource="/Images/document_new_32.png" SmallImageSource="/Images/document_new_16.png">
                            <RibbonMenuItem Header="Company" ImageSource="/Images/factory_24.png" Height="24"></RibbonMenuItem>
                            <RibbonMenuItem Header="Contactperson" ImageSource="/Images/businessmen_24.png" Height="24"></RibbonMenuItem>
                        </RibbonMenuButton>
                        <RibbonButton Label="Create company" LargeImageSource="/Images/factory_new_32.png" SmallImageSource="/Images/factory_new_16.png"></RibbonButton>
                    </RibbonGroup>
                </RibbonTab>
                <RibbonTab Header="Settings"></RibbonTab>
            </Ribbon>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"></ColumnDefinition>
                    <ColumnDefinition Width="3"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition Height="3"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"></RowDefinition>
                            <RowDefinition Height="1"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            
                        </StackPanel>
                        <Label Grid.Row="1" Background="{DynamicResource desktop.bordercolor}"></Label>
                    </Grid>
                    <GridSplitter Grid.Row="1" Background="{DynamicResource desktop.bordercolor}"></GridSplitter>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"></RowDefinition>
                            <RowDefinition Height="1"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        </StackPanel>
                        <Label Grid.Row="1" Background="{DynamicResource desktop.bordercolor}"></Label>
                    </Grid>
                </Grid>
                <GridSplitter Grid.Column="1" Background="{DynamicResource desktop.bordercolor}"></GridSplitter>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="3"></ColumnDefinition>
                        <ColumnDefinition Width="180"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition Height="3"></RowDefinition>
                            <RowDefinition Height="240"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TabControl>
                                <TabItem Header="{DynamicResource desktop.output.header.dashboard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1"></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                            <RowDefinition Height="1"></RowDefinition>
                                            <RowDefinition></RowDefinition>
                                            <RowDefinition Height="1"></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Background="{DynamicResource desktop.bordercolor}"></Label>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal"></StackPanel>
                                        <Label Grid.Row="2" Background="{DynamicResource desktop.bordercolor}"></Label>
                                        <Grid Grid.Row="3">
                                            
                                        </Grid>
                                        <Label Grid.Row="4" Background="{DynamicResource desktop.bordercolor}"></Label>
                                        <StackPanel Grid.Row="5" Orientation="Horizontal"></StackPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{DynamicResource desktop.output.header.companies}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1"></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                            <RowDefinition Height="1"></RowDefinition>
                                            <RowDefinition></RowDefinition>
                                            <RowDefinition Height="1"></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Background="{DynamicResource desktop.bordercolor}"></Label>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal"></StackPanel>
                                        <Label Grid.Row="2" Background="{DynamicResource desktop.bordercolor}"></Label>
                                        <Grid Grid.Row="3">

                                        </Grid>
                                        <Label Grid.Row="4" Background="{DynamicResource desktop.bordercolor}"></Label>
                                        <StackPanel Grid.Row="5" Orientation="Horizontal"></StackPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{DynamicResource desktop.output.header.activities}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1"></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                            <RowDefinition Height="1"></RowDefinition>
                                            <RowDefinition></RowDefinition>
                                            <RowDefinition Height="1"></RowDefinition>
                                            <RowDefinition Height="25"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Background="{DynamicResource desktop.bordercolor}"></Label>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal"></StackPanel>
                                        <Label Grid.Row="2" Background="{DynamicResource desktop.bordercolor}"></Label>
                                        <Grid Grid.Row="3">

                                        </Grid>
                                        <Label Grid.Row="4" Background="{DynamicResource desktop.bordercolor}"></Label>
                                        <StackPanel Grid.Row="5" Orientation="Horizontal"></StackPanel>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                        <GridSplitter Grid.Row="1" Background="{DynamicResource desktop.bordercolor}"></GridSplitter>
                        <Grid Grid.Row="2">
                            <TabControl TabStripPlacement="Bottom">
                                <TabItem Header="{DynamicResource desktop.relations.header.contactpersons}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25"></RowDefinition>
                                            <RowDefinition Height="1"></RowDefinition>
                                            <RowDefinition></RowDefinition>
                                            <RowDefinition Height="1"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            
                                        </StackPanel>
                                        <Label Grid.Row="1" Background="{DynamicResource desktop.bordercolor}"></Label>
                                        <Grid Grid.Row="2">
                                            
                                        </Grid>
                                        <Label Grid.Row="3" Background="{DynamicResource desktop.bordercolor}"></Label>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{DynamicResource desktop.relations.header.activities}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25"></RowDefinition>
                                            <RowDefinition Height="1"></RowDefinition>
                                            <RowDefinition></RowDefinition>
                                            <RowDefinition Height="1"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">

                                        </StackPanel>
                                        <Label Grid.Row="1" Background="{DynamicResource desktop.bordercolor}"></Label>
                                        <Grid Grid.Row="2">

                                        </Grid>
                                        <Label Grid.Row="3" Background="{DynamicResource desktop.bordercolor}"></Label>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                    <GridSplitter Grid.Column="1" Background="{DynamicResource desktop.bordercolor}"></GridSplitter>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition Height="3"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            </StackPanel>
                            <Label Grid.Row="1" Background="{DynamicResource desktop.bordercolor}"></Label>

                        </Grid>
                        <GridSplitter Grid.Row="1" Background="{DynamicResource desktop.bordercolor}"></GridSplitter>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            </StackPanel>
                            <Label Grid.Row="1" Background="{DynamicResource desktop.bordercolor}"></Label>

                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <Label Grid.Row="4" Background="{DynamicResource desktop.bordercolor}"></Label>
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="16"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    
                </StackPanel>
                <ProgressBar Grid.Column="2" Width="180" Visibility="Collapsed"></ProgressBar>
                <Label Grid.Column="4" VerticalAlignment="Center" Padding="0" Content="©2000 Emdesoft Developments A/S"></Label>
            </Grid>
        </Grid>
    </Border>
</Window>
