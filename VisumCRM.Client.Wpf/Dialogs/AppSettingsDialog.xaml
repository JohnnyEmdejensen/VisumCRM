<Window x:Class="VisumCRM.Client.Wpf.Dialogs.AppSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisumCRM.Client.Wpf.Dialogs"
        mc:Ignorable="d"
        Tag="AppSettings" MinHeight="400" Height="400" MinWidth="350" Width="350" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Icon="/Images/environment_48.png">
    <Border CornerRadius="16" BorderThickness="3" BorderBrush="{DynamicResource dialog.bordercolor}" Background="{DynamicResource dialog.background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="3"></RowDefinition>
                <RowDefinition Height="60"></RowDefinition>
                <RowDefinition Height="3"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="3"></RowDefinition>
                <RowDefinition Height="39"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtTitle" MouseLeftButtonDown="txtTitle_MouseLeftButtonDown" Grid.Column="0" Style="{DynamicResource dialog.titlebar.text}" Text="{DynamicResource appsettings.header.title}" VerticalAlignment="Center"></TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Image x:Name="imgMin" MouseLeftButtonDown="imgMin_MouseLeftButtonDown" Source="/Images/minimize.png" Cursor="Hand"></Image>
                    <Label Width="8" Visibility="Collapsed"></Label>
                    <Image x:Name="imgMax" MouseLeftButtonDown="imgMax_MouseLeftButtonDown" Source="/Images/maximize.png" Cursor="Hand" Visibility="Collapsed"></Image>
                    <Image x:Name="imgRes" MouseLeftButtonDown="imgRes_MouseLeftButtonDown" Source="/Images/restore.png" Cursor="Hand" Visibility="Collapsed"></Image>
                    <Label Width="8"></Label>
                    <Image x:Name="imgCls" MouseLeftButtonDown="imgCls_MouseLeftButtonDown" Source="/Images/close.png" Cursor="Hand"></Image>
                    <Label Width="8"></Label>
                </StackPanel>
            </Grid>
            <Label Grid.Row="1" Background="{DynamicResource dialog.bordercolor}"></Label>
            <Grid Grid.Row="2" Background="{DynamicResource dialog.top.information.background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="60"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">

                </Grid>
                <Canvas Grid.Column="2" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas.Left>0</Canvas.Left>
                    <Canvas.Top>0</Canvas.Top>
                    <Image x:Name="imgDialog" Source="/Images/environment_48.png" Width="48" Height="48" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Image x:Name="imgDialogState" Source="/Images/add_24.png" Visibility="Collapsed" Width="24" Height="24" Stretch="Fill" Opacity="0.75" Canvas.Left="24" Canvas.Top="0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Canvas>
            </Grid>
            <Label Grid.Row="3" Background="{DynamicResource dialog.bordercolor}"></Label>
            <TabControl Grid.Row="4">
                <TabItem Header="{DynamicResource appsettings.tab.header.application}">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"></RowDefinition>
                            <RowDefinition Height="8"></RowDefinition>
                            <RowDefinition Height="36"></RowDefinition>
                            <RowDefinition Height="8"></RowDefinition>
                            <RowDefinition Height="36"></RowDefinition>
                            <RowDefinition Height="8"></RowDefinition>
                            <RowDefinition Height="36"></RowDefinition>
                            <RowDefinition Height="8"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource appsettings.header.publicdocumentfolder}" Style="{StaticResource HeaderLabel}"></Label>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition Width="24"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtPublicFolder" Grid.Column="0"></TextBox>
                                <Button Grid.Column="2" x:Name="btnPublicFolder" Click="btnPublicFolder_Click">
                                    <Image Source="/Images/folder_16.png"></Image>
                                </Button>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource appsettings.header.privatedocumentfolder}" Style="{StaticResource HeaderLabel}"></Label>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition Width="24"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtPrivateFolder" Grid.Column="0"></TextBox>
                                <Button Grid.Column="2" x:Name="btnPrivateFolder" Click="btnPrivateFolder_Click">
                                    <Image Source="/Images/folder_16.png"></Image>
                                </Button>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource appsettings.header.themes}" Style="{StaticResource HeaderLabel}"></Label>
                            <ComboBox Grid.Row="1" x:Name="cboThemes" SelectionChanged="cboThemes_SelectionChanged"></ComboBox>
                        </Grid>
                        <Grid Grid.Row="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource appsettings.header.languages}" Style="{StaticResource HeaderLabel}"></Label>
                            <ComboBox Grid.Row="1" x:Name="cboLanguages" SelectionChanged="cboLanguages_SelectionChanged"></ComboBox>
                        </Grid>
                        <Grid Grid.Row="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource appsettings.header.useautocompanynumber}" Style="{StaticResource HeaderLabel}"></Label>
                            <CheckBox x:Name="chkUseAutoNumber" Grid.Row="1" VerticalAlignment="Center" Margin="32 0"></CheckBox>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource appsettings.tab.header.database}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"></RowDefinition>
                            <RowDefinition Height="8"></RowDefinition>
                            <RowDefinition Height="36"></RowDefinition>
                            <RowDefinition Height="8"></RowDefinition>
                            <RowDefinition Height="36"></RowDefinition>
                            <RowDefinition Height="8"></RowDefinition>
                            <RowDefinition Height="36"></RowDefinition>
                            <RowDefinition Height="8"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource appsettings.header.serverpath}" Style="{StaticResource HeaderLabel}"></Label>
                            <TextBox Grid.Row="1" x:Name="txtServerPath"></TextBox>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource appsettings.header.databasename}" Style="{StaticResource HeaderLabel}"></Label>
                            <TextBox Grid.Row="1" x:Name="txtDatabaseName"></TextBox>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="8"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16"></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Content="{DynamicResource appsettings.header.usetrustedconnection}" Style="{StaticResource HeaderLabel}"></Label>
                                <CheckBox Grid.Row="1" x:Name="chkUseTrusted" VerticalAlignment="Center" HorizontalAlignment="Center"></CheckBox>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16"></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Content="{DynamicResource appsettings.header.trustcertificate}" Style="{StaticResource HeaderLabel}"></Label>
                                <CheckBox Grid.Row="1" x:Name="chkTrustCert" VerticalAlignment="Center" HorizontalAlignment="Center"></CheckBox>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="6" x:Name="grdLogininfo" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="8"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16"></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Content="{DynamicResource appsettings.header.login}" Style="{StaticResource HeaderLabel}"></Label>
                                <TextBox Grid.Row="1" x:Name="txtLogin"></TextBox>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16"></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Content="{DynamicResource appsettings.header.password}" Style="{StaticResource HeaderLabel}"></Label>
                                <PasswordBox Grid.Row="1" x:Name="txtpassword"></PasswordBox>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource appsettings.header.databasecreation}" Style="{StaticResource HeaderLabel}"></Label>
                            <Button x:Name="btnCreateDatabase" IsEnabled="False" Content="{DynamicResource appsettings.header.createdatebase}" Padding="8 0 8 0" Height="23" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"></Button>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
            <Label Grid.Row="5" Background="{DynamicResource dialog.bordercolor}"></Label>
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="75"></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="75"></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="8"></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="8"></RowDefinition>
                </Grid.RowDefinitions>
                <Button x:Name="btnCancel" Click="btnCancel_Click" Grid.Row="1" Grid.Column="3" Content="{DynamicResource appsettings.button.header.cancel}" IsCancel="True"></Button>
                <Button x:Name="btnOK" Click="btnOK_Click" Grid.Row="1" Grid.Column="1" Content="{DynamicResource appsettings.button.header.ok}" IsDefault="True"></Button>
            </Grid>
        </Grid>        
    </Border>
</Window>
