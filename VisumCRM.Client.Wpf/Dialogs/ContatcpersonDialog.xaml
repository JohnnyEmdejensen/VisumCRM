<Window x:Class="VisumCRM.Client.Wpf.Dialogs.ContatcpersonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisumCRM.Client.Wpf.Dialogs"
        mc:Ignorable="d"
        Tag="Contatcperson" ResizeMode="CanResizeWithGrip" MinHeight="600" Height="600" MinWidth="800" Width="800" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Icon="/Images/businessmen_48.png">
    <Border CornerRadius="16" BorderThickness="3" BorderBrush="{DynamicResource dialog.bordercolor}" Background="{DynamicResource dialog.background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="3"></RowDefinition>
                <RowDefinition Height="60"></RowDefinition>
                <RowDefinition Height="3"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="3"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="3"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtTitle" MouseLeftButtonDown="txtTitle_MouseLeftButtonDown" Grid.Column="0" Style="{DynamicResource dialog.titlebar.text}" Text="{DynamicResource contatcperson.header.title}" VerticalAlignment="Center"></TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Image x:Name="imgMin" MouseLeftButtonDown="imgMin_MouseLeftButtonDown" Source="/Images/minimize.png" Cursor="Hand"></Image>
                    <Label Width="8" Visibility="Collapsed"></Label>
                    <Image x:Name="imgMax" MouseLeftButtonDown="imgMax_MouseLeftButtonDown" Source="/Images/maximize.png" Cursor="Hand" Visibility="Collapsed"></Image>
                    <Image x:Name="imgRes" MouseLeftButtonDown="imgRes_MouseLeftButtonDown" Source="/Images/restore.png" Cursor="Hand" Visibility="Collapsed"></Image>
                    <Label Width="8"></Label>
                    <Image x:Name="imgCls" MouseLeftButtonDown="imgCls_MouseLeftButtonDown" Source="/Images/close.png" Cursor="Hand"></Image>
                    <Label Width="8"></Label>
                </StackPanel>
            </Grid>
            <Label Grid.Row="1" Background="{DynamicResource dialog.bordercolor}"></Label>
            <Grid Grid.Row="2" Background="{DynamicResource dialog.top.information.background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="60"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">

                </Grid>
                <Canvas Grid.Column="2" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas.Left>0</Canvas.Left>
                    <Canvas.Top>0</Canvas.Top>
                    <Image x:Name="imgDialog" Source="/Images/businessmen_48.png" Width="48" Height="48" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Image x:Name="imgDialogState" Source="/Images/add_24.png" Width="24" Height="24" Stretch="Fill" Canvas.Left="0" Canvas.Top="0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Canvas>
            </Grid>
            <Label Grid.Row="3" Background="{DynamicResource dialog.bordercolor}"></Label>
            <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Label Width="8"></Label>
                <Button x:Name="btnAdd" Click="btnAdd_Click" Style="{StaticResource ToolbarButton}" IsEnabled="False">
                    <Image Source="/Images/add_24.png" Cursor="Hand"></Image>
                </Button>
                <Label Width="8"></Label>
                <Button x:Name="btnSave" Click="btnSave_Click" Style="{StaticResource ToolbarButton}" IsEnabled="False">
                    <Image Source="/Images/disk_blue_24.png" Cursor="Hand"></Image>
                </Button>
                <Label Width="8"></Label>
                <Button x:Name="btnSaveClose" Click="btnSaveClose_Click" Style="{StaticResource ToolbarButton}" IsEnabled="False">
                    <Image Source="/Images/disk_green_24.png" Cursor="Hand"></Image>
                </Button>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2"></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition Height="2"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"></ColumnDefinition>
                        <ColumnDefinition Width="2"></ColumnDefinition>
                        <ColumnDefinition Width="8"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="1" Grid.Row="1" Background="{DynamicResource dialog.bordercolor}"></Label>
                </Grid>
                <Button x:Name="btnDelete" Click="btnDelete_Click" Style="{StaticResource ToolbarButton}" IsEnabled="False">
                    <Image Source="/Images/delete_24.png" Cursor="Hand"></Image>
                </Button>
            </StackPanel>
            <Label Grid.Row="5" Background="{DynamicResource dialog.bordercolor}"></Label>
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="3"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="8 0 4 8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"></RowDefinition>
                        <RowDefinition Height="8"></RowDefinition>
                        <RowDefinition Height="36"></RowDefinition>
                        <RowDefinition Height="8"></RowDefinition>
                        <RowDefinition Height="36"></RowDefinition>
                        <RowDefinition Height="8"></RowDefinition>
                        <RowDefinition Height="36"></RowDefinition>
                        <RowDefinition Height="8"></RowDefinition>
                        <RowDefinition Height="36"></RowDefinition>
                        <RowDefinition Height="8"></RowDefinition>
                        <RowDefinition Height="36"></RowDefinition>
                        <RowDefinition Height="8"></RowDefinition>
                        <RowDefinition Height="36"></RowDefinition>
                        <RowDefinition Height="8"></RowDefinition>
                        <RowDefinition Height="36"></RowDefinition>
                        <RowDefinition Height="8"></RowDefinition>
                        <RowDefinition Height="36"></RowDefinition>
                        <RowDefinition Height="8"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Content="{DynamicResource contactperson.header.firstname}" Style="{StaticResource HeaderLabel}"></Label>
                        <TextBox x:Name="txtFirstname" Grid.Row="1" Text="{Binding Path=Firstname}" MaxLength="128"></TextBox>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Content="{DynamicResource contactperson.header.middlename}" Style="{StaticResource HeaderLabel}"></Label>
                        <TextBox Grid.Row="1" Text="{Binding Path=Middlename}" MaxLength="128"></TextBox>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Content="{DynamicResource contactperson.header.surname}" Style="{StaticResource HeaderLabel}"></Label>
                        <TextBox Grid.Row="1" Text="{Binding Path=Surname}" MaxLength="128"></TextBox>
                    </Grid>
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="8"></ColumnDefinition>
                            <ColumnDefinition Width="56"></ColumnDefinition>
                            <ColumnDefinition Width="8"></ColumnDefinition>
                            <ColumnDefinition Width="48"></ColumnDefinition>
                            <ColumnDefinition Width="8"></ColumnDefinition>
                            <ColumnDefinition Width="48"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource contactperson.header.street}" Style="{StaticResource HeaderLabel}"></Label>
                            <TextBox x:Name="txtStreet" Grid.Row="1" MaxLength="128" ></TextBox>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource contactperson.header.house}" Style="{StaticResource HeaderLabel}"></Label>
                            <TextBox x:Name="txtHouse" Grid.Row="1" MaxLength="16" ></TextBox>
                        </Grid>
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource contactperson.header.floor}" Style="{StaticResource HeaderLabel}"></Label>
                            <TextBox x:Name="txtFloor" Grid.Row="1" MaxLength="8" ></TextBox>
                        </Grid>
                        <Grid Grid.Column="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource contactperson.header.door}" Style="{StaticResource HeaderLabel}"></Label>
                            <TextBox x:Name="txtDoor" Grid.Row="1" MaxLength="8" ></TextBox>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"></ColumnDefinition>
                            <ColumnDefinition Width="8"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource contactperson.header.zipcode}" Style="{StaticResource HeaderLabel}"></Label>
                            <TextBox x:Name="txtZipcode" Grid.Row="1" MaxLength="24" ></TextBox>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource contactperson.header.city}" Style="{StaticResource HeaderLabel}"></Label>
                            <TextBox x:Name="txtCity" Grid.Row="1" MaxLength="128" ></TextBox>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Content="{DynamicResource contactperson.header.country}" Style="{StaticResource HeaderLabel}"></Label>
                        <ComboBox x:Name="cboCountry" Grid.Row="1"></ComboBox>
                    </Grid>
                    <Grid Grid.Row="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="8"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource contactperson.header.phone}" Style="{StaticResource HeaderLabel}"></Label>
                            <TextBox Grid.Row="1" MaxLength="16" Text="{Binding Path=Phone}" ></TextBox>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource contactperson.header.mobile}" Style="{StaticResource HeaderLabel}"></Label>
                            <TextBox Grid.Row="1" Text="{Binding Path=Mobile}" MaxLength="16" ></TextBox>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Content="{DynamicResource contactperson.header.email}" Style="{StaticResource HeaderLabel}"></Label>
                        <TextBox Grid.Row="1" Text="{Binding Path=Email}" MaxLength="16" ></TextBox>
                    </Grid>
                    <Grid Grid.Row="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label x:Name="lblJobtitle" Content="{DynamicResource contactperson.header.jobtitle}" Style="{StaticResource HeaderLabelClickAble}" MouseDown="lblJobtitle_MouseDown"></Label>
                        <ComboBox x:Name="cboJobtitle" Grid.Row="1" SelectedValue="{Binding Path=JobtitleId}"></ComboBox>
                    </Grid>

                </Grid>
                <GridSplitter Grid.Column="1"></GridSplitter>
                <TabControl Grid.Column="2">
                    <TabItem Header="{DynamicResource contatcperson.tab.header.contactperson}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"></RowDefinition>
                                <RowDefinition Height="8"></RowDefinition>
                                <RowDefinition Height="36"></RowDefinition>
                                <RowDefinition Height="8"></RowDefinition>
                                <RowDefinition Height="36"></RowDefinition>
                                <RowDefinition Height="8"></RowDefinition>
                                <RowDefinition Height="36"></RowDefinition>
                                <RowDefinition Height="8"></RowDefinition>
                                <RowDefinition Height="36"></RowDefinition>
                                <RowDefinition Height="8"></RowDefinition>
                                <RowDefinition Height="36"></RowDefinition>
                                <RowDefinition Height="8"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16"></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Content="{DynamicResource contactperson.header.salesperson}" Style="{StaticResource HeaderLabel}"></Label>
                                <ComboBox x:Name="cboSalespersons" Grid.Row="1" SelectedValue="{Binding Path=SalespersonId}" ></ComboBox>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16"></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Content="{DynamicResource contactperson.header.employer}" Style="{StaticResource HeaderLabel}"></Label>
                                <ComboBox x:Name="cboEmployees" Grid.Row="1" SelectedValue="{Binding Path=EmployeerId}" ></ComboBox>
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="16"></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Label Content="{DynamicResource contactperson.header.birthday}" Style="{StaticResource HeaderLabel}"></Label>
                                    <TextBox x:Name="txtBirthday" Grid.Row="1" ></TextBox>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="16"></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
            <Label Grid.Row="7" Background="{DynamicResource dialog.bordercolor}"></Label>
            <StackPanel Grid.Row="8">
                
            </StackPanel>
        </Grid>
    </Border>
</Window>
